generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis(schema: "public")]
}

model Pandal {
  id              String          @id @default(cuid())
  name            String
  locality        String
  theme           String?
  description     String?
  year            Int
  topPandal       TopPandal?
  eventYear       String
  imageUrls       String[]
  bannerImageUrl  String
  latitude        Float
  longitude       Float
  createdAt       DateTime        @default(now())
  biswarjanQueues BiswarjanQueue?
  checkins        Checkins[]

  @@index([latitude, longitude, id])
}

model TopPandal {
  id         String      @id @default(cuid())
  pandalId   String      @unique
  pandal     Pandal      @relation(fields: [pandalId], references: [id],onDelete: Cascade)
  crowdLevel crowdStatus
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Checkins {
  id         String      @id @default(cuid())
  crowdLevel crowdStatus
  pandalId   String
  createdAt  DateTime    @default(now())
  pandal     Pandal      @relation(fields: [pandalId], references: [id], onDelete: Cascade)

  @@index([pandalId, createdAt, id])
}

model BiswarjanQueue {
  id        String    @id @default(cuid())
  pandalId  String    @unique
  serialNo  Int       @unique
  status    String    @default("WAITING")
  startedAt DateTime? @default(now())
  createdAt DateTime  @default(now())
  pandal    Pandal    @relation(fields: [pandalId], references: [id],onDelete: Cascade)

  @@index([serialNo])
}

model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum crowdStatus {
  CALM
  BUSY
  PACKED
}
